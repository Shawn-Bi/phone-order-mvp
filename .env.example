# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

# Vapi.ai — https://dashboard.vapi.ai/  (Settings -> API Keys)
VAPI_PRIVATE_KEY=your_vapi_private_key
VAPI_PUBLIC_KEY=your_vapi_public_key

# Twilio — https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15555550123

# OpenAI — used as the LLM brain behind the Vapi assistant
OPENAI_API_KEY=your_openai_api_key

# Public base URL of the webhook_server.py process.
# Must be set BEFORE running setup_vapi.py, since it's baked into the
# assistant's tool definition so Vapi knows where to send the order data.
# Production is the Railway deployment (below). For local development,
# run `ngrok http 5000` and use the https URL it prints instead.
# setup_vapi.py --webhook-url <url> overrides this value for a single run.
WEBHOOK_BASE_URL=https://phone-order-mvp-production.up.railway.app

# Port the local webhook server listens on
WEBHOOK_PORT=5000
